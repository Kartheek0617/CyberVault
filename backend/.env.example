# ─────────────────────────────────────────────────────────────────────────────
# CyberVault Backend — Environment Configuration Template
# Copy this file to .env and fill in values before running the application.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cybervault:securepassword@localhost:5432/cybervault_db

# ── Application Security ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_generate_a_random_64_byte_hex_string

# ── JWT Settings ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# ── Evidence Encryption (AES-256-GCM) ────────────────────────────────────────
# 32-byte key, base64-encoded. Generate with:
# python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_base64_encoded_32_byte_key

# ── Digital Signatures (Ed25519) ──────────────────────────────────────────────
# These are generated automatically on first run if not provided.
# For production, generate and store separately:
# python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; import base64; k=Ed25519PrivateKey.generate(); print(base64.b64encode(k.private_bytes_raw()).decode())"
SIGNING_PRIVATE_KEY_B64=CHANGE_ME_base64_encoded_ed25519_private_key
SIGNING_PUBLIC_KEY_B64=CHANGE_ME_base64_encoded_ed25519_public_key

# ── Storage ───────────────────────────────────────────────────────────────────
# Absolute path to encrypted evidence storage directory (outside web root)
EVIDENCE_STORAGE_PATH=./evidence_storage

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
